#!/usr/bin/env bash
set -euo pipefail
config_dir=${CLAUDE_CONFIG_DIR:-"$HOME/.claude"}
install_dir=${CCGUARD_HOME:-"$config_dir/ccguard"}
. "$install_dir/lib/wrapper-common.sh"
ccguard_load_credentials
export CCGUARD_PROMPT=off CCGUARD_GATE=off
binary=$(ccguard_find_claude)
printf '\033[2mccguard bare: minimal system prompt; prompt anchor and local gate are off\033[0m\n' >&2
ccguard_exec "$binary" --system-prompt-file "$install_dir/prompts/bare-system.txt" "$@"
